{
	"hard_tabs": true,
	"preferred_line_length": 100,
	"wrap_guides": [100, 120],
	"show_whitespaces": "all",
	"colorize_brackets": true,
	"indent_guides": {
		"coloring": "indent_aware",
	},
	"file_finder": {
		"modal_max_width": "medium",
	},
	"sticky_scroll": {
		"enabled": true,
	},
	"inlay_hints": {
		"enabled": true,
	},
	"git": {
		"inline_blame": {
			"show_commit_summary": true,
		},
	},
	"git_panel": {
		"group_by": "staging",
	},
	"calls": {
		"mute_on_join": true,
	},
	"agent": {
		"show_turn_stats": true,
		"auto_compact": {
			"enabled": false,
		},
		"default_model": {
			"provider": "copilot_chat",
			"model": "gemini-4-carbon",
			"enable_thinking": true,
			"effort": "medium",
		},
		"inline_assistant_model": {
			"provider": "copilot_chat",
			"model": "gpt-6.1-sol",
		},
		"commit_message_model": {
			"provider": "copilot_chat",
			"model": "gpt-6.1-terra",
		},
		"thread_summary_model": {
			"provider": "copilot_chat",
			"model": "claude-haiku-5.5",
		},
		"compaction_model": {
			"provider": "copilot_chat",
			"model": "gemini-4-hydrogen",
		},
		"subagent_model": {
			"provider": "copilot_chat",
			"model": "gemini-4-hydrogen",
			"enable_thinking": true,
			"effort": "high",
		},
		"favorite_models": [
			{
				"provider": "copilot_chat",
				"model": "gemini-4-carbon",
				"enable_thinking": true,
				"effort": "medium",
			},
			{
				"provider": "copilot_chat",
				"model": "claude-opus-5.5",
				"enable_thinking": true,
				"effort": "xhigh",
			},
			{
				"provider": "copilot_chat",
				"model": "gemini-4-hydrogen",
				"enable_thinking": true,
				"effort": "high",
			},
			{
				"provider": "copilot_chat",
				"model": "gpt-6.1-sol",
				"enable_thinking": true,
				"effort": "xhigh",
			},
		],
		"sandbox_permissions": {
			"write_paths": ["/tmp"],
			"network_hosts": [
				"developer.apple.com",
				"*.aws.amazon.com",
				"ffmpeg.org",
				"dashif.org",
				"*.github.com",
				"*.github.io",
				"*.githubusercontent.com",
				"gh.io",
				"github.blog",
				"github.com",
				"*.iso.org",
				"iso639-3.sil.org",
				"learn.microsoft.com",
				"*.mpeg.org",
				"nginx.org",
				"*.opentofu.org",
				"opentofu.org",
				"*.rfc-editor.org",
				"*.w3.org",
				"webmproject.org",
				"zed.dev",
			],
		},
		"tool_permissions": {
			"tools": {
				"skill": {
					"default": "allow",
				},
				"fetch": {
					"default": "allow",
				},
				"terminal": {
					"always_allow": [
						{ "pattern": "^printenv TMPDIR$" },
						{ "pattern": "^(cat|ls|head|tail|nl|stat|wc)\\b" },
						{ "pattern": "^(grep|rg|find|diff)\\b" },
						{ "pattern": "^(sed|awk|cut|sort|uniq|tr|jq)\\b" },
						{ "pattern": "^(echo|printf|read|which|command|sleep|true)\\b" },
						{
							"pattern": "^git( -C [^\\s]+)?( --no-(pager|optional-locks))* (status|log|reflog|diff|show|rev-parse|ls-tree|branch|blame|grep|clang-format|worktree|range-diff|ls-files|merge-base|symbolic-ref)\\b",
						},
						{
							"pattern": "^git( -C [^\\s]+)?( --no-pager)? tag( (-l|--list|--sort=[^\\s]+))?$",
						},
						{ "pattern": "^gh (run|pr) (list|view)\\b" },
						{ "pattern": "^(gofmt|go (test|build|vet|doc|list|version))\\b" },
						{ "pattern": "^(tofu|terraform) (fmt|validate|show|init)\\b" },
						{
							"pattern": "^(cc|clang-format|iwyu_tool\\.py|fix_includes\\.py)\\b",
						},
						{ "pattern": "^(ffprobe|mp4dump)\\b" },
						{ "pattern": "^docker (ps|images|inspect|logs|version|info)\\b" },
					],
					"always_deny": [
						{ "pattern": "\\bsed\\b.*\\s-[a-zA-Z]*i" },
						{ "pattern": "\\bfind\\b.*-(exec|delete)" },
					],
				},
			},
		},
	},
	"languages": {
		"TypeScript": {
			"inlay_hints": {
				"show_type_hints": false,
			},
		},
	},
	"edit_predictions": {
		"provider": "copilot",
	},
	"theme": "Dracula",
	"base_keymap": "Atom",
	"buffer_font_family": "JetBrains Mono",
	"buffer_font_size": 13,
	"terminal": {
		"font_family": "Monaco",
		"minimum_contrast": 0,
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false,
	},
}
