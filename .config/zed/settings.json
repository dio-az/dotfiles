{
	"format_on_save": "off",
	"hard_tabs": true,
	"tab_size": 4,
	"preferred_line_length": 100,
	"wrap_guides": [100, 120],
	"soft_wrap": "none",
	"show_whitespaces": "all",
	"colorize_brackets": true,
	"indent_guides": {
		"coloring": "indent_aware",
	},
	"file_finder": {
		"modal_max_width": "medium",
	},
	"sticky_scroll": {
		"enabled": true,
	},
	"inlay_hints": {
		"enabled": true,
	},
	"git": {
		"inline_blame": {
			"show_commit_summary": true,
		},
	},
	"calls": {
		"mute_on_join": true,
	},
	"agent": {
		"default_model": {
			"effort": "high",
			"provider": "anthropic",
			"model": "claude-opus-4-8",
			"enable_thinking": true,
		},
		"inline_assistant_model": {
			"provider": "openai",
			"model": "gpt-5.3-codex",
		},
		"commit_message_model": {
			"provider": "anthropic",
			"model": "claude-haiku-4-5",
		},
		"thread_summary_model": {
			"provider": "anthropic",
			"model": "claude-sonnet-4-6",
		},
		"subagent_model": {
			"provider": "anthropic",
			"model": "claude-sonnet-4-6",
		},
		"inline_alternatives": [
			{
				"provider": "anthropic",
				"model": "claude-sonnet-4-6",
				"enable_thinking": true,
				"effort": "high",
			},
			{
				"provider": "anthropic",
				"model": "claude-opus-4-7",
				"enable_thinking": true,
				"effort": "high",
			},
		],
		"favorite_models": [
			{
				"provider": "anthropic",
				"model": "claude-opus-4-8",
				"enable_thinking": true,
				"effort": "high",
			},
			{
				"provider": "anthropic",
				"model": "claude-sonnet-4-6",
				"enable_thinking": true,
				"effort": "high",
			},
			{
				"provider": "copilot_chat",
				"model": "gpt-5.5",
				"enable_thinking": true,
				"effort": "xhigh",
			},
			{
				"provider": "copilot_chat",
				"model": "gemini-3.1-pro-preview",
				"enable_thinking": true,
				"effort": "high",
			},
			{
				"provider": "copilot_chat",
				"model": "claude-opus-4.8",
				"enable_thinking": true,
				"effort": "medium",
			},
		],
		"tool_permissions": {
			"tools": {
				"terminal": {
					"always_allow": [
						{ "pattern": "^cat\\b" },
						{ "pattern": "^ls\\b" },
						{ "pattern": "^head\\b" },
						{ "pattern": "^tail\\b" },
						{ "pattern": "^grep\\b" },
						{ "pattern": "^find\\b" },
						{ "pattern": "^diff\\b" },
						{ "pattern": "^echo\\b" },
						{ "pattern": "^sed\\b" },
						{ "pattern": "^awk\\b" },
						{ "pattern": "^sort\\b" },
						{ "pattern": "^wc\\b" },
						{ "pattern": "^git --no-pager status\\b" },
						{ "pattern": "^git --no-pager (log|diff|show)\\b" },
						{ "pattern": "^git --no-pager tag$" },
						{ "pattern": "^git --no-pager tag (-l|--list)$" },
					],
					"always_confirm": [{ "pattern": "^sed\\s+-i\\b" }],
				},
				"fetch": {
					"always_allow": [
						{ "pattern": "github\\.com" },
						{ "pattern": "raw\\.githubusercontent\\.com" },
					],
				},
			},
		},
	},
	"languages": {
		"TypeScript": {
			"inlay_hints": {
				"show_type_hints": false,
			},
		},
	},
	"edit_predictions": {
		"allow_data_collection": "no",
		"provider": "copilot",
	},
	"theme": "Dracula",
	"base_keymap": "Atom",
	"buffer_font_family": "JetBrains Mono",
	"buffer_font_size": 13.0,
	"terminal": {
		"font_family": "Monaco",
		"minimum_contrast": 0.0,
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false,
	},
}
