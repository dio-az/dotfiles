{
	"format_on_save": "off",
	"hard_tabs": true,
	"tab_size": 4,
	"preferred_line_length": 100,
	"wrap_guides": [100, 120],
	"show_whitespaces": "all",
	"colorize_brackets": true,
	"indent_guides": {
		"coloring": "indent_aware",
	},
	"file_finder": {
		"modal_max_width": "medium",
	},
	"sticky_scroll": {
		"enabled": true,
	},
	"inlay_hints": {
		"enabled": true,
	},
	"git": {
		"inline_blame": {
			"show_commit_summary": true,
		},
	},
	"git_panel": {
		"group_by": "staging",
	},
	"calls": {
		"mute_on_join": true,
	},
	"agent": {
		"show_turn_stats": true,
		"auto_compact": {
			"enabled": false,
		},
		"default_model": {
			"effort": "high",
			"provider": "copilot_chat",
			"model": "claude-opus-5-5",
			"enable_thinking": true,
		},
		"inline_assistant_model": {
			"provider": "copilot_chat",
			"model": "gpt-6-sol",
		},
		"commit_message_model": {
			"provider": "copilot_chat",
			"model": "gemini-3.8-flash",
		},
		"thread_summary_model": {
			"provider": "copilot_chat",
			"model": "gpt-6-luna",
		},
		"subagent_model": {
			"provider": "copilot_chat",
			"model": "claude-sonnet-5-5",
			"enable_thinking": true,
			"effort": "high",
		},
		"favorite_models": [
			{
				"provider": "copilot_chat",
				"model": "claude-opus-5-5",
				"enable_thinking": true,
				"effort": "high",
			},
			{
				"provider": "copilot_chat",
				"model": "claude-sonnet-5-5",
				"enable_thinking": true,
				"effort": "high",
			},
			{
				"provider": "copilot_chat",
				"model": "gpt-6-sol",
				"enable_thinking": true,
				"effort": "xhigh",
			},
			{
				"provider": "copilot_chat",
				"model": "gpt-6-astra",
				"enable_thinking": true,
				"effort": "high",
			},
			{
				"provider": "copilot_chat",
				"model": "gemini-3.8-flash",
				"enable_thinking": true,
				"effort": "high",
			},
		],
		"sandbox_permissions": {
			"network_hosts": ["github.com", "api.github.com", "raw.githubusercontent.com"],
		},
		"tool_permissions": {
			"tools": {
				"skill": {
					"default": "allow",
				},
				"terminal": {
					"always_allow": [
						{ "pattern": "^cat\\b" },
						{ "pattern": "^ls\\b" },
						{ "pattern": "^head\\b" },
						{ "pattern": "^tail\\b" },
						{ "pattern": "^(grep|rg)\\b" },
						{ "pattern": "^find\\b" },
						{ "pattern": "^diff\\b" },
						{ "pattern": "^echo\\b" },
						{ "pattern": "^printf\\b" },
						{ "pattern": "^sed\\b" },
						{ "pattern": "^awk\\b" },
						{ "pattern": "^sort\\b" },
						{ "pattern": "^wc\\b" },
						{ "pattern": "^nl\\b" },
						{ "pattern": "^tr\\b" },
						{ "pattern": "^which\\b" },
						{ "pattern": "^command\\b" },
						{ "pattern": "^sleep\\b" },
						{ "pattern": "^true\\b" },
						{
							"pattern": "^git( --no-(pager|optional-locks))* (status|log|diff|show|rev-parse|ls-tree|branch|blame|grep|clang-format|worktree|range-diff)\\b",
						},
						{ "pattern": "^git( --no-pager)? tag$" },
						{ "pattern": "^git( --no-pager)? tag (-l|--list|--sort=[^\\s]+)$" },
						{ "pattern": "^go (test|build|vet|doc|list|version)\\b" },
						{ "pattern": "^gofmt\\b" },
						{ "pattern": "^(tofu|terraform) (fmt|validate|show|init)\\b" },
						{ "pattern": "^clang-format\\b" },
						{ "pattern": "^iwyu_tool.py\\b" },
						{ "pattern": "^fix_includes.py\\b" },
						{ "pattern": "^cc\\b" },
						{ "pattern": "^ffprobe\\b" },
						{ "pattern": "^mp4dump\\b" },
						{ "pattern": "^docker (ps|images|inspect|logs|version|info)\\b" },
					],
					"always_confirm": [{ "pattern": "^sed -i\\b" }],
				},
				"fetch": {
					"always_allow": [
						{ "pattern": "github\\.com" },
						{ "pattern": "raw\\.githubusercontent\\.com" },
					],
				},
			},
		},
	},
	"languages": {
		"TypeScript": {
			"inlay_hints": {
				"show_type_hints": false,
			},
		},
	},
	"edit_predictions": {
		"allow_data_collection": "no",
		"provider": "copilot",
	},
	"theme": "Dracula",
	"base_keymap": "Atom",
	"buffer_font_family": "JetBrains Mono",
	"buffer_font_size": 13,
	"terminal": {
		"font_family": "Monaco",
		"minimum_contrast": 0,
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false,
	},
}
